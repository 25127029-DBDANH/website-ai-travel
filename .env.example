# Optional local Docker Compose overrides. Values below are for local use only.
APP_ENV=development
POSTGRES_PASSWORD=postgres
# Production Neon Postgres pooled URL example (set real value only in hosting dashboard):
# DATABASE_URL=postgresql://USER:CHANGE_ME@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
JWT_SECRET=local-only-change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
