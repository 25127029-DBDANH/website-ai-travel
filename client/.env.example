# API Gateway Configuration (Issue #11)
# Set VITE_USE_BACKEND=true to connect to the FastAPI Backend (Auth, Trips, Gemini AI, Places).
# Set VITE_USE_BACKEND=false to use local Mock Data offline without requiring the backend server.
VITE_USE_BACKEND=true

# FastAPI Backend Base URL (no trailing slash)
VITE_API_BASE=http://localhost:8000

# Google Identity Services Web Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
