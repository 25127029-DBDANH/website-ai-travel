# Database configuration (local SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./travel.db
# PostgreSQL / Supabase example:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/travel_db

# Google Places API (New)
GOOGLE_PLACES_API_KEY=

# Google Gemini API (set GEMINI_MODEL to a model enabled for your project)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Frontend origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT configuration used by the authentication module
SECRET_KEY=
