# Copy this file to server/.env for local development. Never put real secrets here.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travel_ai_hcmc
JWT_SECRET=replace-with-a-random-local-secret-at-least-32-characters
SECRET_KEY=replace-with-a-random-local-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CALENDAR_CREDENTIALS_JSON=
DEMO_FALLBACK_MODE=true
