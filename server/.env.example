# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hcmc_travel_db

# Security & JWT Authentication
JWT_SECRET=super_secret_jwt_key_hcmc_travel_ai_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Key (Model: gemini-1.5-pro / gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Places API (New) Key
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google Calendar OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
