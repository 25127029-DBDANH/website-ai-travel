# Application environment ("development" | "production")
# In production, JWT_SECRET must be changed from the default value.
APP_ENV=development

# Database configuration
# Local SQLite development (default):
DATABASE_URL=sqlite+aiosqlite:///./travel.db

# Production Neon Postgres (pooled connection string, Singapore region):
# DATABASE_URL=postgresql://USER:CHANGE_ME@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT Auth
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS (comma-separated frontend origins, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Google Gemini API (set GEMINI_MODEL to a model enabled for your project)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=25

# Google Places API (New)
GOOGLE_PLACES_API_KEY=

# Google OAuth (Google Identity Services Web Client ID)
GOOGLE_CLIENT_ID=

# Password recovery email (Gmail uses an App Password)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_WEB_URL=
